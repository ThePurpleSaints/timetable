# Copy this file to `.env` and fill in real values.
# The `.env` file is git-ignored and should never be committed.

# Release signing (used by app/build.gradle.kts via signingSecret()).
# Optional only if you skip building a signed release APK.
STORE_PASSWORD=your-keystore-password
KEY_PASSWORD=your-key-password
KEYSTORE_PATH=/absolute/path/to/your-upload-key.jks